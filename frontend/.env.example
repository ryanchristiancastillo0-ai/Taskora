# Copy to .env and adjust. This file is committed; .env is not.
#
# VITE_BACKEND_URL is the backend's bare origin: no trailing slash, no trailing
# /api. Local:
#   VITE_BACKEND_URL=http://localhost:8080
# Deployed (Render, Railway, Fly, a VPS...):
#   VITE_BACKEND_URL=https://api.taskora.app
#
# Nothing else needs editing to deploy. The REST base URL, the Socket.IO origin
# and all asset/upload URLs are derived from this value in
# src/shared/api/config.js.
#
# Remember to set the backend's CORS_ORIGIN to the deployed frontend origin, e.g.
#   CORS_ORIGIN=https://taskora.app
# otherwise the browser will block the API and the socket handshake.
#
# Vite only exposes VITE_-prefixed variables, and only to the browser. Never put
# a secret here — this value is public.
VITE_BACKEND_URL=http://localhost:8080
